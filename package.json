{
  "name": "open-envault",
  "version": "0.3.2",
  "description": "Local-first SOPS-compatible secrets for Git and Rust",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayanmohsin/open-envault.git"
  },
  "homepage": "https://github.com/sayanmohsin/open-envault#readme",
  "bugs": {
    "url": "https://github.com/sayanmohsin/open-envault/issues"
  },
  "license": "(Apache-2.0 OR MIT)",
  "keywords": [
    "sops",
    "age",
    "dotenv",
    "secrets",
    "env",
    "encryption"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "oenv": "bin/oenv.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "prebuilds/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:version": "node scripts/check-version.mjs",
    "pack:check": "npm pack --dry-run"
  }
}
